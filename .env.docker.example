# Generate .env.docker with npm run docker:init. Never commit the generated secrets.
POSTGRES_PASSWORD=
METIQUO_API_PASSWORD=
METIQUO_WORKER_PASSWORD=
METIQUO_AUTH_SECRET=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MAILPIT_PORT=8025
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@metiquo.fr
PGADMIN_DEFAULT_PASSWORD=
# HTTP cookies are permitted only for loopback origins. Use true behind HTTPS.
METIQUO_AUTH_COOKIE_SECURE=false
# JSON array. Adjust this list if WEB_PORT or the development origin changes.
METIQUO_AUTH_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080","http://127.0.0.1:5173","http://localhost:5173"]
METIQUO_SMTP_HOST=mailpit
METIQUO_SMTP_PORT=1025
METIQUO_SMTP_SECURITY=none
METIQUO_SMTP_FROM=connexion@metiquo.fr
VITE_DATA_MODE=mock
VITE_DONATION_URL=
VITE_STAKE_REFERRAL_URL=https://stake.bet/?c=8f9c282663
METIQUO_ORACLE_ENABLED=true
# Set only after verifying the timezone of naive Oracle CSV timestamps.
# Empty keeps the raw data but does not invent temporal match associations.
METIQUO_ORACLE_DATE_TIMEZONE=
METIQUO_CATALOG_ENABLED=true
# Pauses do not prove a low request volume. Compare the passive network metrics.
# The bundled image contains full Chromium; chrome requires a Chrome Stable installation.

# Schedule frequencies are managed in the Admin UI and stored in PostgreSQL.

# LoLTV: documents HTML, enrichissement DOM et budget durable.
METIQUO_LOLTV_ENABLED=true
METIQUO_LOLTV_BROWSER_CHANNEL=chromium
METIQUO_LOLTV_FEED_ENABLED=true
METIQUO_LOLTV_RENDER_LIVE=false
METIQUO_LOLTV_MIN_DELAY_SECONDS=2
METIQUO_LOLTV_MAX_DELAY_SECONDS=4
METIQUO_LOLTV_LISTING_INTERVAL_SECONDS=60
METIQUO_LOLTV_RESULTS_INTERVAL_SECONDS=300
METIQUO_LOLTV_FUTURE_LISTING_INTERVAL_SECONDS=900
METIQUO_LOLTV_LIVE_REFRESH_SECONDS=30
METIQUO_LOLTV_FINISHED_REFRESH_SECONDS=21600
METIQUO_LOLTV_INCOMPLETE_REFRESH_SECONDS=900
METIQUO_LOLTV_BLOCK_COOLDOWN_SECONDS=900
METIQUO_LOLTV_REQUEST_BUDGET=120
METIQUO_LOLTV_BROWSER_REQUEST_BUDGET=600
METIQUO_LOLTV_BUDGET_WINDOW_SECONDS=600
METIQUO_LOLTV_CYCLE_SECONDS=90

# Stake : collecteur Chrome avec interface, lancé sur l’hôte via scripts/stake-worker.ps1.
# La planification */10 est administrable dans l’application.
DB_DEV_PORT=54329
METIQUO_STAKE_GAMES=["league-of-legends"]
METIQUO_STAKE_MIN_DELAY_SECONDS=5
METIQUO_STAKE_TIMEOUT_SECONDS=45
METIQUO_STAKE_CYCLE_SECONDS=600
METIQUO_STAKE_MAX_ACTIONS=300
METIQUO_STAKE_REQUEST_BUDGET=30000
METIQUO_STAKE_BUDGET_WINDOW_SECONDS=1200
METIQUO_STAKE_BLOCK_COOLDOWN_SECONDS=3600
METIQUO_STAKE_START_GUARD_SECONDS=60
