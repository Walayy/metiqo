# Generate .env.docker with npm run docker:init. Never commit the generated secrets.
POSTGRES_PASSWORD=
METIQUO_API_PASSWORD=
METIQUO_WORKER_PASSWORD=
METIQUO_AUTH_SECRET=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MAILPIT_PORT=8025
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@metiquo.fr
PGADMIN_DEFAULT_PASSWORD=
# HTTP cookies are permitted only for loopback origins. Use true behind HTTPS.
METIQUO_AUTH_COOKIE_SECURE=false
# JSON array. Adjust this list if WEB_PORT or the development origin changes.
METIQUO_AUTH_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080","http://127.0.0.1:5173","http://localhost:5173"]
METIQUO_SMTP_HOST=mailpit
METIQUO_SMTP_PORT=1025
METIQUO_SMTP_SECURITY=none
METIQUO_SMTP_FROM=connexion@metiquo.fr
VITE_DATA_MODE=mock
METIQUO_ORACLE_ENABLED=true
METIQUO_ORACLE_INTERVAL_SECONDS=21600
METIQUO_ORACLE_FULL_REFRESH_SECONDS=604800
METIQUO_CATALOG_ENABLED=true
METIQUO_CATALOG_INTERVAL_SECONDS=86400
