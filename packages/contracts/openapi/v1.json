{
  "components": {
    "schemas": {
      "DataMode": {
        "description": "Origine isolée des données applicatives.",
        "enum": [
          "mock",
          "real"
        ],
        "title": "DataMode",
        "type": "string"
      },
      "DependencyStatus": {
        "additionalProperties": false,
        "description": "État synthétique d'une dépendance de disponibilité.",
        "properties": {
          "reasonCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoncode"
          },
          "status": {
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Santé du processus, indépendante des services externes.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "Erreur HTTP compatible RFC 9457, successeur de RFC 7807.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "context": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Context",
            "type": "object"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadyResponse": {
        "additionalProperties": false,
        "description": "Disponibilité globale de l'API.",
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SystemStatusResponse": {
        "additionalProperties": false,
        "description": "État minimal versionné du système.",
        "properties": {
          "apiVersion": {
            "title": "Apiversion",
            "type": "string"
          },
          "dataMode": {
            "$ref": "#/components/schemas/DataMode"
          },
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "generatedAt": {
            "format": "date-time",
            "title": "Generatedat",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "apiVersion",
          "dataMode",
          "generatedAt",
          "dependencies"
        ],
        "title": "SystemStatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Metiquo API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
