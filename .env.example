# Exécution
APP_ENV=development
APP_DATA_MODE=mock
DATABASE_URL=postgresql+psycopg://metiquo@postgres:5432/metiquo

# Stockage objet
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_ROOT=/data

# Affichage uniquement ; les instants internes restent en UTC
DISPLAY_TIMEZONE=Europe/Paris

# Oracle's Elixir
OE_ALLOW_STALE=true
OE_REQUIRE_FRESH=false
OE_CURRENT_YEAR=2026
OE_FRESHNESS_SLA_SECONDS=10800
MODEL_FRESHNESS_SLA_SECONDS=2592000
OE_SOURCE_CATALOG_PATH=/app/config/oracles_elixir_sources.yml
OE_CONNECT_TIMEOUT_SECONDS=10
OE_READ_TIMEOUT_SECONDS=60
OE_DOWNLOAD_TIMEOUT_SECONDS=900
OE_MAX_DOWNLOAD_BYTES=4294967296
OE_MAX_REDIRECTS=3
OE_RETRY_MAX_ATTEMPTS=4
OE_RETRY_BASE_SECONDS=1
OE_RETRY_MAX_SECONDS=30

# File PostgreSQL et planification en mode réel
WORKER_SCHEDULER_ENABLED=true
WORKER_SCHEDULER_TICK_SECONDS=15
WORKER_RETRY_DELAYS_SECONDS=[600,1800,7200]
WORKER_RETRY_JITTER_FRACTION=0.1
OE_SYNC_INTERVAL_SECONDS=10800
OE_CLOSED_AUDIT_MONTHS=1
OE_DEEP_CHECK_INTERVAL_SECONDS=86400
PAPER_SETTLEMENT_INTERVAL_SECONDS=300
PAPER_REPORT_INTERVAL_SECONDS=300
ALERT_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=21600
ALERT_MAPPING_BACKLOG_LIMIT=10

# Cotes
ODDS_PROVIDER=mock
ODDS_MAX_AGE_SECONDS=90
# Surcharges JSON facultatives, par provider, marché puis phase
# ODDS_PROVIDER_MAX_AGE_SECONDS={"manual-lab":300}
# ODDS_MARKET_MAX_AGE_SECONDS={"MATCH_WINNER":120}
# ODDS_PHASE_MAX_AGE_SECONDS={"prematch":90}
MOCK_SEED=metiquo-demo-v1
STAKE_PROVIDER_ENABLED=false
STAKE_WRITTEN_AUTHORIZATION_CONFIRMED=false
STAKE_LAWFUL_JURISDICTION_CONFIRMED=false
STAKE_LEGAL_VALIDATION_CONFIRMED=false

# Politique de signal initiale, destinée à être versionnée
SIGNAL_MIN_EDGE=0.03
SIGNAL_MIN_EV=0.05
SIGNAL_MIN_CONSERVATIVE_EV=0.00
SIGNAL_MAX_KELLY_FRACTION=0.25
SIGNAL_MIN_MAPPING_CONFIDENCE=0.80

# Bankroll exclusivement fictive ; entrées manuelles, sans suggestion automatique
PAPER_BANKROLL_POLICY_VERSION=paper-manual-v1
PAPER_BANKROLL_CURRENCY=EUR
PAPER_BANKROLL_INITIAL=1000
PAPER_MAX_OPEN_EXPOSURE=100
PAPER_SETTLEMENT_DELAY_SECONDS=300
PAPER_SETTLEMENT_MAX_ATTEMPTS=3
PAPER_CLOSING_MAX_AGE_SECONDS=90
